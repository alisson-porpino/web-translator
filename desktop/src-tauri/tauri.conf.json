{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manga Web Translator",
  "version": "1.0.1",
  "identifier": "com.alissonporpino.manga-web-translator",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Manga Web Translator",
        "width": 440,
        "height": 700,
        "resizable": true,
        "minWidth": 380,
        "minHeight": 500,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.4"
    },
    "resources": {
      "resources/extension-chrome.zip": "extension-chrome.zip",
      "resources/extension-firefox.zip": "extension-firefox.zip"
    }
  }
}
